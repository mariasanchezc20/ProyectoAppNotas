# ----- Servidor -----
NODE_ENV=development
PORT=4000
# URL pública del backend (usada en el correo de verificación)
APP_URL=http://localhost:4000
# Origen permitido para CORS (la app móvil / web)
CLIENT_ORIGIN=*

# ----- Base de datos -----
MONGO_URI=mongodb://127.0.0.1:27017/notes_app

# ----- JWT -----
# Genera secretos largos y aleatorios (ej: openssl rand -hex 64)
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_diferente
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ----- Correo (SMTP) -----
# En desarrollo puedes usar https://ethereal.email (cuenta de prueba)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=password_smtp
MAIL_FROM="Notes App <no-reply@notes.app>"

# ----- HTTPS (producción) -----
# Rutas a los certificados TLS. Si están vacías, el server arranca en HTTP (solo dev).
TLS_KEY_PATH=
TLS_CERT_PATH=
